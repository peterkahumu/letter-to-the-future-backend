# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never commit it.


# =========================================================
# REQUIRED — production AND local
# =========================================================

# Postgres connection string from Neon. The asyncpg driver is added for you.
DATABASE_URL=

# Signs unsubscribe links AND every account access token. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Paste it WITHOUT quotes. Changing it breaks unsubscribe links already sent
# and signs every account out — which is also the emergency lever if you
# ever think a token has leaked.
SECRET_KEY=

# Comma-separated allowed origins.
# The FIRST one builds every confirm / cancel / unsubscribe link inside emails.
# Locally: http://localhost:3000   In production: your real site URL.
FRONTEND_URL=

# How mail goes out: console | smtp | resend   (empty means smtp)
# console = printed to the terminal, nothing sent. Handy locally.
EMAIL_PROVIDER=

# Mail server. For Gmail: smtp.gmail.com
SMTP_HOST=

# Must be 465. The code connects over SSL, not STARTTLS — 587 just hangs.
SMTP_PORT=465

# The Gmail address that sends the mail.
SMTP_USER=

# Gmail App Password, not your login password. Needs 2-Step Verification on.
# Remove the spaces Google shows you.
SMTP_PASSWORD=

# Display name in the From header. Empty means no name is shown.
SMTP_FROM_NAME=

# From address. Empty means same as SMTP_USER.
# Gmail rejects any address that is not the logged-in account.
SMTP_FROM_EMAIL=

# Cloudinary credentials for media uploads: cloudinary://key:secret@cloud-name
# Uploads return a 502 without it.
CLOUDINARY_URL=

# true turns on verbose application logging. Keep false in production.
DEBUG=false

# Runs alembic migrations when the app boots.
# Keep false locally — your local .env points at the production database,
# so starting the app would migrate production. Set true in production only.
RUN_MIGRATIONS_ON_STARTUP=false


# =========================================================
# LOCAL ONLY
# =========================================================

# Plain SMTP with no TLS and no login, for a local mail catcher like Mailpit.
# Never set this true against Gmail.
SMTP_INSECURE=false

# Prints every SQL statement. Very noisy — only for debugging queries.
SQL_ECHO=false


# =========================================================
# PRODUCTION ONLY
# =========================================================

# Postal address shown in the footer of every email. Required by CAN-SPAM,
# and its absence hurts deliverability.
MAILING_ADDRESS=

# Sentry project URL, for alerts when a delivery or request fails.
# Blank means errors only reach stdout and vanish on restart.
SENTRY_DSN=

# Extra allowed origins by pattern, for things like preview deploys.
# Must match the whole origin. Paste WITHOUT quotes.
ALLOWED_ORIGIN_REGEX=

# Only read when EMAIL_PROVIDER=resend.
RESEND_API_KEY=


# =========================================================
# OPTIONAL — defaults live in app/config.py. Uncomment to override.
# =========================================================

# --- Accounts --------------------------------------------------
# The first person to register with this address becomes an admin. Set it,
# sign up, then blank it — leaving it set means anyone who can read your
# environment knows which address to try to take over.
# BOOTSTRAP_ADMIN_EMAIL=

# Access tokens are held in the browser, so they are short by design and the
# client refreshes them. Raising this widens the window a leaked token works.
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30
# PASSWORD_RESET_EXPIRE_MINUTES=60
# MIN_PASSWORD_LENGTH=10

# Require a confirmed address before an account can write. Turn OFF locally,
# where mail goes to the console; leave ON anywhere real.
# REQUIRE_EMAIL_VERIFICATION=true

# --- Abuse limits ----------------------------------------------
# RATE_LIMIT_LOGIN=10/hour
# RATE_LIMIT_REGISTER=5/hour
# RATE_LIMIT_PASSWORD_RESET=5/hour
# RATE_LIMIT_CREATE=5/hour
# RATE_LIMIT_UPLOAD=10/hour
# RATE_LIMIT_REPORT=20/hour
# MAX_UPLOAD_BYTES=10485760
# MAX_PENDING_PER_RECIPIENT=20
# SCHEDULER_BATCH_SIZE=100
# MAX_DELIVERY_ATTEMPTS=5
